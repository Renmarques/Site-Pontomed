# Ponto Med - .htaccess (Hostinger / Apache)
# Troque seudominio.com.br pelo dominio real. Padrao escolhido: SEM www.

DirectoryIndex index.html
DirectorySlash Off
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# 1) Forcar HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://seudominio.com.br%{REQUEST_URI} [L,R=301]

# 2) www -> sem www (para usar COM www, troque a regra e o dominio)
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://seudominio.com.br%{REQUEST_URI} [L,R=301]

# 3) Tirar a barra final: /muletas/ -> /muletas
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+)/$ /$1 [L,R=301]

# 4) URLs sem .html: /muletas serve /muletas/index.html
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+)$ /$1/index.html [L]
</IfModule>

# Pagina 404 personalizada
ErrorDocument 404 /404/index.html

# Compressao gzip
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>

# Cache do navegador
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType text/javascript "access plus 1 month"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
